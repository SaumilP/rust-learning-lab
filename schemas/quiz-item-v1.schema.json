{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-learning-lab.dev/schemas/quiz-item-v1.schema.json",
  "title": "Rust Learning Lab quiz item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "topic", "difficulty", "concepts", "question", "choices", "answer", "explanation", "references"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["multiple_choice", "will_it_compile", "predict_output", "code_review", "fix_error", "design_choice"] },
    "topic": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "concepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "question": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
    "answer": { "$ref": "#/$defs/answer" },
    "explanation": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["choice", "compiles", "output", "review", "fix"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
