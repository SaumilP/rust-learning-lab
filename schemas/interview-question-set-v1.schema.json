{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust Learning Lab interview question set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category", "questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "category": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "focus", "prompt", "evaluation_criteria"],
        "properties": {
          "id": { "type": "string" },
          "level": {
            "enum": [
              "foundation",
              "working_rust_developer",
              "senior_rust_developer",
              "systems_performance_specialist"
            ]
          },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "prompt": { "type": "string", "minLength": 1 },
          "evaluation_criteria": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
